{
  "name": "essence-don-aire-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de Essence Don Aire (Node + Express + PostgreSQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
