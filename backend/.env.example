# ============================================================
# Essence Don Aire - variables de entorno de la API
# Copia este archivo como .env y complétalo. El .env NO se sube a Git.
# ============================================================

# Puerto local. En Vercel no se usa: allá la API corre como función.
PORT=4000

# --- Base de datos: elige UNA de las dos formas ---------------

# (A) En la nube (Neon, Supabase, Render). Una sola cadena.
#     Usa la cadena "pooled" si el proveedor la ofrece.
# DATABASE_URL=postgresql://usuario:clave@ep-algo-pooler.us-east-2.aws.neon.tech/essence_don_aire?sslmode=require

# (B) En tu equipo. Variables sueltas.
PGHOST=localhost
PGPORT=5432
PGDATABASE=essence_don_aire
PGUSER=postgres
PGPASSWORD=tu_clave_de_postgres

# SSL: se decide solo (apagado en localhost, encendido fuera).
# Descomenta solo si necesitas forzarlo.
# PGSSL=true

# --- Sesión ---------------------------------------------------
# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# --- CORS -----------------------------------------------------
# Orígenes del frontend, separados por coma.
# Se admite el comodín de subdominio para las vistas previas de Vercel.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://*.vercel.app
